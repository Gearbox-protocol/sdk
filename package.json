{
  "name": "@gearbox-protocol/sdk",
  "version": "0.0.0-semantic-release",
  "description": "Gearbox SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gearbox-protocol/sdk.git"
  },
  "main": "./dist/cjs/sdk/index.js",
  "module": "./dist/esm/sdk/index.js",
  "types": "./dist/types/sdk/index.d.ts",
  "typings": "./dist/types/sdk/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/sdk/index.d.ts",
      "import": "./dist/esm/sdk/index.js",
      "default": "./dist/cjs/sdk/index.js"
    },
    "./dev": {
      "types": "./dist/types/dev/index.d.ts",
      "import": "./dist/esm/dev/index.js",
      "default": "./dist/cjs/dev/index.js"
    },
    "./history": {
      "types": "./dist/types/history/index.d.ts",
      "import": "./dist/esm/history/index.js",
      "default": "./dist/cjs/history/index.js"
    },
    "./model": {
      "types": "./dist/types/model/index.d.ts",
      "import": "./dist/esm/model/index.js",
      "default": "./dist/cjs/model/index.js"
    },
    "./onchain": {
      "types": "./dist/types/onchain/index.d.ts",
      "import": "./dist/esm/onchain/index.js",
      "default": "./dist/cjs/onchain/index.js"
    },
    "./offchain": {
      "types": "./dist/types/offchain/index.d.ts",
      "import": "./dist/esm/offchain/index.js",
      "default": "./dist/cjs/offchain/index.js"
    },
    "./plugins/*": {
      "types": "./dist/types/plugins/*/index.d.ts",
      "import": "./dist/esm/plugins/*/index.js",
      "default": "./dist/cjs/plugins/*/index.js"
    },
    "./abi/*": {
      "types": "./dist/types/abi/*.d.ts",
      "import": "./dist/esm/abi/*.js",
      "default": "./dist/cjs/abi/*.js"
    },
    "./permissionless": {
      "types": "./dist/types/permissionless/index.d.ts",
      "import": "./dist/esm/permissionless/index.js",
      "default": "./dist/cjs/permissionless/index.js"
    },
    "./testnets": {
      "types": "./dist/types/testnets/index.d.ts",
      "import": "./dist/esm/testnets/index.js",
      "default": "./dist/cjs/testnets/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "example": "tsx scripts/example.ts | pino-pretty",
    "list-opportunities": "tsx scripts/list-opportunities.ts",
    "test:watch": "vitest --project unit --project api",
    "test:unit": "vitest run --project unit --project api",
    "test:api": "vitest run --project api",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test": "vitest run",
    "generate:e2e": "NODE_OPTIONS='--max-old-space-size=8192' tsx dev/scripts/generate-e2e-fixtures.ts",
    "tx:decode": "tsx dev/txdiff/cli.ts decode",
    "tx:diff": "tsx dev/txdiff/cli.ts diff",
    "prepare": "husky",
    "check": "biome check --write",
    "check:ci": "biome check --diagnostic-level=error",
    "typecheck:ci": "tsc --noEmit"
  },
  "dependencies": {
    "abitype": "^1.3.0",
    "date-fns": "^4.4.0",
    "viem": ">=2.23.15 <3.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@gearbox-protocol/biome-config": "^1.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "viem-deal": "^2.0.4",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "viem-deal": "^2.0.4"
  },
  "peerDependenciesMeta": {
    "viem-deal": {
      "optional": true
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,json}": [
      "biome check --no-errors-on-unmatched --write"
    ]
  },
  "foundryVersion": "1.7.1",
  "packageManager": "pnpm@12.11.2"
}
