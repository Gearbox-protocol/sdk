{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "declaration": true,
    "removeComments": false,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "scripts",
    "ci",
    "dev",
    "tsdown.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
